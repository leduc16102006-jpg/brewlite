// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Product {
  id         Int          @id @default(autoincrement())
  name       String
  price      Int
  imageUrl   String?
  stock      Int          @default(0)
  version    Int          @default(0)
  orderItems OrderItem[]
  recipes    RecipeItem[]
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  status    String   @default("PENDING")
  total     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  items              OrderItem[]
  payments           Payment[]
  subtotal           Int                 @default(0)
  discountAmount     Int                 @default(0)
  promotionId        Int?
  promotion          Promotion?          @relation(fields: [promotionId], references: [id])
  loyaltyTransaction LoyaltyTransaction?

  ingredientsReserved Boolean           @default(false)
  ingredientUses      OrderIngredient[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  size      String?
  qty       Int
  lineTotal Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id             Int      @id @default(autoincrement())
  orderId        Int
  amount         Int
  method         String
  status         String
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Promotion {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  type           String // PERCENT hoặc FIXED
  value          Int
  maxDiscount    Int?
  minOrderAmount Int      @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  orders Order[]
}

model LoyaltyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  orderId   Int      @unique
  points    Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
}

model Ingredient {
  id           Int               @id @default(autoincrement())
  name         String            @unique
  unit         String
  stock        Int               @default(0)
  version      Int               @default(0)
  recipeItems  RecipeItem[]
  toppingItems ToppingRecipe[]
  orderUses    OrderIngredient[]
}

model RecipeItem {
  id           Int    @id @default(autoincrement())
  productId    Int
  ingredientId Int
  size         String @default("DEFAULT")
  quantity     Int

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, size, ingredientId])
  @@index([ingredientId])
}

model ToppingRecipe {
  id           Int    @id @default(autoincrement())
  name         String
  ingredientId Int
  quantity     Int

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([name, ingredientId])
  @@index([ingredientId])
}

model OrderIngredient {
  orderId      Int
  ingredientId Int
  quantity     Int

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([orderId, ingredientId])
  @@index([ingredientId])
}
